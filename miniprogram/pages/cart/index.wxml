<!-- pages/cart/index.wxml -->
<!-- 导航栏 -->
<navigation-bar title="{{editMode ? '编辑购物车' : '购物车'}}" back="{{false}}" color="#FFFFFF" background="#8B4513"></navigation-bar>

<view class="cart-page">
  <!-- 加载状态 -->
  <view wx:if="{{loading}}" class="loading-state">
    <view class="loading-spinner"></view>
    <text class="loading-text">加载中...</text>
  </view>

  <!-- 错误状态 -->
  <view wx:elif="{{error}}" class="error-state">
    <view class="error-icon">!</view>
    <text class="error-text">{{error}}</text>
    <button class="retry-btn" bindtap="onRetry">重新加载</button>
  </view>

  <!-- 空购物车 -->
  <view wx:elif="{{cartItems.length === 0}}" class="empty-state">
    <view class="empty-icon">
      <image src="/images/empty-cart.png" mode="aspectFit" wx:if="{{false}}"></image>
      <view class="empty-icon-placeholder">🛒</view>
    </view>
    <text class="empty-title">购物车还是空的</text>
    <text class="empty-desc">快去挑选心仪的中药材吧</text>
    <button class="go-shop-btn" bindtap="goShopping">去逛逛</button>
  </view>

  <!-- 购物车内容 -->
  <view wx:else class="cart-content">
    <!-- 管理栏 -->
    <view class="cart-header">
      <view class="header-left">
        <text class="header-title">共 {{cartItems.length}} 件商品</text>
      </view>
      <view class="header-right">
        <button class="manage-btn {{editMode ? 'active' : ''}}" bindtap="toggleEditMode">
          {{editMode ? '完成' : '管理'}}
        </button>
      </view>
    </view>

    <!-- 商品列表 -->
    <scroll-view class="cart-list" scroll-y enhanced show-scrollbar="{{false}}" refresher-enabled refresher-triggered="{{loading}}" bindrefresherrefresh="onPullDownRefresh">
      <view class="cart-items">
        <cart-item
          wx:for="{{cartItems}}"
          wx:key="productId"
          item="{{item}}"
          selected="{{selectedItems.indexOf(item.productId) !== -1}}"
          edit-mode="{{editMode}}"
          bind:select="onItemSelect"
          bind:quantitychange="onQuantityChange"
          bind:delete="onItemDelete"
          bind:producttap="onProductTap"
        />
      </view>
    </scroll-view>

    <!-- 底部操作栏 -->
    <cart-bottom-bar
      select-all="{{selectAll}}"
      selected-count="{{selectedItems.length}}"
      total-price="{{summary.totalPrice}}"
      discount-amount="{{summary.discountAmount}}"
      final-price="{{summary.finalPrice}}"
      edit-mode="{{editMode}}"
      bind:selectall="onSelectAll"
      bind:checkout="onCheckout"
      bind:batchdelete="onBatchDelete"
      bind:discountdetail="onDiscountDetailTap"
    />
  </view>
</view>