<!-- components/cart-bottom-bar/index.wxml -->
<view class="cart-bottom-bar {{editMode ? 'edit-mode' : ''}}">
  <!-- 全选 -->
  <view class="select-all" bindtap="onSelectAllTap">
    <view class="checkbox {{selectAll ? 'checked' : ''}}">
      <text wx:if="{{selectAll}}" class="check-mark">✓</text>
    </view>
    <text class="label">全选</text>
  </view>

  <!-- 合计信息 -->
  <view wx:if="{{!editMode}}" class="price-section">
    <view class="count-row">
      <text class="count-text">共 {{selectedCount}} 件</text>
      <text wx:if="{{discountAmount > 0}}" class="discount-link" bindtap="onDiscountDetailTap">
        已优惠 ¥{{formatPrice(discountAmount)}}
      </text>
    </view>
    <view class="price-row">
      <text class="price-label">合计：</text>
      <text class="price-value">¥{{formatPrice(finalPrice)}}</text>
      <text wx:if="{{discountAmount > 0}}" class="original-price">¥{{formatPrice(totalPrice)}}</text>
    </view>
  </view>

  <!-- 操作按钮 -->
  <view class="action-btn-wrap">
    <button
      wx:if="{{editMode}}"
      class="action-btn delete-btn {{selectedCount > 0 ? 'active' : ''}}"
      disabled="{{selectedCount === 0}}"
      bindtap="onBatchDeleteTap"
    >
      删除({{selectedCount}})
    </button>
    <button
      wx:else
      class="action-btn checkout-btn {{selectedCount > 0 ? 'active' : ''}}"
      disabled="{{selectedCount === 0}}"
      bindtap="onCheckoutTap"
    >
      结算({{selectedCount}})
    </button>
  </view>
</view>