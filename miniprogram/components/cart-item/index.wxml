<!-- components/cart-item/index.wxml -->
<view class="cart-item {{selected ? 'selected' : ''}} {{editMode ? 'edit-mode' : ''}}">
  <!-- 选择框 -->
  <view class="select-area" bindtap="onSelectToggle">
    <view class="checkbox {{selected ? 'checked' : ''}}">
      <text wx:if="{{selected}}" class="check-mark">✓</text>
    </view>
  </view>

  <!-- 商品图片 -->
  <view class="product-img" bindtap="onProductTap">
    <image
      src="{{item.product.image}}"
      mode="aspectFill"
      lazy-load
      bindload="onImageLoad"
      binderror="onImageError"
    />
    <view wx:if="{{stockStatus === 'out'}}" class="stock-mask">
      <text>缺货</text>
    </view>
  </view>

  <!-- 商品信息 -->
  <view class="product-info" bindtap="onProductTap">
    <text class="product-name">{{item.product.name}}</text>
    
    <view wx:if="{{item.product.specs && item.product.specs.length > 0}}" class="spec-tag" bindtap="onSpecTap">
      <text>{{getSelectedSpecText()}}</text>
      <text class="spec-arrow">›</text>
    </view>

    <view class="price-row">
      <text class="price">{{getDisplayPrice()}}</text>
      <text wx:if="{{hasDiscount()}}" class="original-price">{{getOriginalPrice()}}</text>
    </view>
  </view>

  <!-- 操作区域 -->
  <view class="action-area">
    <view wx:if="{{editMode}}" class="delete-btn" bindtap="onDeleteTap">
      <text>删除</text>
    </view>
    <view wx:else class="quantity-control">
      <view class="qty-btn" bindtap="onQuantityChange" data-type="minus">−</view>
      <text class="qty-value">{{item.quantity}}</text>
      <view class="qty-btn" bindtap="onQuantityChange" data-type="plus">+</view>
    </view>
  </view>
</view>